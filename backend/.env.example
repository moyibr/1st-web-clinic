# MongoDB Atlas (shared cluster — one DB, tenants separated by tenantId in each document)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dental_clinic_saas

# SMTP for outgoing notification/confirmation emails (e.g. Gmail SMTP, Resend, SendGrid SMTP relay)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your-smtp-password-or-api-key
SMTP_FROM=no-reply@yourdomain.com
